# URL acessível pelo servidor Next.js. Em Docker Compose, use o nome do
# serviço Nest, por exemplo: http://api:3000
API_INTERNAL_URL=http://localhost:3001

# URL pública e canônica do frontend, usada em metadados, robots e sitemap.
SITE_URL=http://localhost:3000

# Variáveis NEXT_PUBLIC são incorporadas ao bundle durante `next build`.
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# Ativa a nova landing page em "/" (Hero, Manifesto, Oficina, Como Funciona,
# Onde Estamos, Produtos, Fechamento) no lugar da home atual. "true" para ativar.
NEW_LANDING_PAGE_ENABLED=false

# Porta publicada pelo Docker Compose.
APP_PORT=3000
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Ativa o pagamento online (PIX/cartão/boleto) no carrinho e na encomenda.
# "false" desativa a criação de pedido pelo sistema: ao finalizar, o cliente
# é redirecionado para o WhatsApp abaixo com um resumo do pedido pronto para
# enviar, e toda a negociação/logística segue por lá. Variável lida só no
# servidor — nunca exposta ao bundle do cliente. Padrão: true (se ausente).
PAYMENT_ENABLED=true

# Número de WhatsApp que recebe os pedidos quando PAYMENT_ENABLED=false.
# Formato: DDI + DDD + número, só dígitos (ex: 5511999999999).
WHATSAPP_NUMBER=
